# ─── Vercel (apps/web) ─────────────────────────────────────────────────────────
# Postgres: Neon, Supabase, Railway, Vercel Postgres, etc.
# Neon: copy "Connection string" from dashboard (often ?sslmode=require).
# Supabase: Project → Settings → Database → URI. Use "Session" pooler for serverless:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# For prisma migrate / db push from laptop, Supabase also offers a "Direct" (5432) URL — use that if pooler errors.
DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# Local dev: put secrets in apps/web/.env.local (Next.js reads it). Prisma CLI only auto-loads apps/web/.env —
# from apps/web run:  ln -sf .env.local .env   then  npx prisma migrate deploy

# Browser wallet sends on /dashboard — use same RPC class as HELIUS when possible (URL is exposed to clients).
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"

# Worker → dashboard ingest (required on Vercel). POST /api/opportunities with header:
#   x-engine-secret: <this value>   OR   Authorization: Bearer <this value>
ENGINE_INGEST_SECRET="generate-with: openssl rand -base64 32"
# Optional alias from older soledge templates (same Bearer auth if set)
ENGINE_BOT_TOKEN=""

# ─── Worker + Meteora core (+ dashboard “Simulate snipe”) ─────────────────────
HELIUS_API_KEY="your-helius-api-key"
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"
SOLANA_WS_URL="wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY"

# Two DLMM pools sharing the same token pair (different bin configs / addresses)
POOL_A=""
POOL_B=""
START_MINT=""
# Multi-pair worker (preferred when scanning >1 route): JSON array — overrides POOL_A/B/MINT when set.
# POOL_PAIRS_JSON='[{"poolA":"...","poolB":"...","startMint":"EPj...","label":"SOL/USDC-1","amountRaw":"1000000"}]'
# Or multiline file:
# POOL_PAIRS_FILE="apps/worker/config/pool-pairs.json"
PAIR_STAGGER_MS="250"
# After curl-only rows land in the DB, merge these into the latest row for Simulate snipe:
#   npm run db:enrich-pools   (from repo root; needs DATABASE_URL where Prisma points)
AMOUNT_RAW="1000000"
POLL_MS="15000"

# Worker runtime (long-lived process — Fly/Railway/etc.)
# poll (default) — HELIUS_API_KEY + POOL_* / POOL_PAIRS_* polling only.
# stream — Yellowstone gRPC (`YELLOWSTONE_GRPC_URL` or `GRPC_URL`). HELIUS only if STREAM_BRIDGE_* is set (compare hook uses RPC).
# both — poll + background gRPC stream.
WORKER_MODE="poll"
# Yellowstone / Geyser gRPC (provider-specific URL). Optional auth header value:
YELLOWSTONE_GRPC_URL=""
GRPC_URL=""
GRPC_X_TOKEN=""
X_TOKEN=""
# Optional: when parsed tx keys include STREAM_BRIDGE_POOL_A, run two-pool compare vs POOL_B/MINT (cooldown-guarded); ingest marks scannerKind=grpc-bridge.
STREAM_BRIDGE_POOL_A=""
STREAM_BRIDGE_POOL_B=""
STREAM_BRIDGE_START_MINT=""
STREAM_BRIDGE_COOLDOWN_MS="8000"
STREAM_BRIDGE_AMOUNT_RAW=""
STREAM_METEORA_PROGRAM_ID=""
STREAM_VERBOSE="false"

# POST opportunities to your deployed Next.js app
DASHBOARD_URL="https://your-app.vercel.app"

# Optional overrides
MIN_PROFIT_MULTIPLE="500"
METEORA_BIN_ARRAY_COUNT="10"
# Floor when auto-shrinking merged txs to fit the 1232-byte legacy packet (+ fee-payer sig)
METEORA_BIN_ARRAY_COUNT_MIN="3"
TOKEN_BLOCKLIST_MINTS=""
ASSUMED_POOL_LIQ_USD="50000"

# ─── Chaos discovery (extra DLMM rows · loose floor · tiny clips) ──────────────
# Dashboard: enable manual scan button + optional cron hitting executeDiscoveryScan via API route pattern.
DISCOVERY_SCAN_ENABLED="0"
DISCOVERY_POOL_PAIRS_JSON=""
# DISCOVERY_POOL_PAIRS_FILE="apps/worker/config/discovery-pairs.json"
DISCOVERY_MIN_PROFIT_MULTIPLE="1.05"
DISCOVERY_AMOUNT_RAW="25000"
DISCOVERY_MAX_PAIRS_PER_SCAN="12"
DISCOVERY_ASSUMED_POOL_LIQ_USD="35000"
# Worker background discovery loop (requires HELIUS). Mirrors POOL_PAIRS_* when true:
DISCOVERY_POLL_MS="0"
DISCOVERY_PAIR_STAGGER_MS="150"
DISCOVERY_MIRROR_POOL_PAIRS="false"
# Rarely use — forwards discovery hits through EXECUTION_MODE live/simulate pipeline:
DISCOVERY_TRIGGER_EXECUTION="false"

# Jito (optional future bundle auth — RPC LIVE path below does not submit bundles yet)
JITO_AUTH_TOKEN=""

# Worker execution: off | simulate | live
# LIVE merges two Meteora DLMM swaps into ONE legacy tx, then either:
#   EXECUTION_SUBMIT=rpc   → sendAndConfirm via your RPC (default)
#   EXECUTION_SUBMIT=jito → Block Engine bundle [arb signed tx, SOL tip tx] — needs competitive tip (lamports).
# Risk: revert, partial fills, sandwich, wasted fees — tune MIN_PROFIT_MULTIPLE + AMOUNT_RAW; simulate first.
EXECUTION_MODE="off"
EXECUTION_SUBMIT="rpc"
# Regional bundles URL — see https://github.com/jito-labs/mev-protos/blob/master/json_rpc/http.md
JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf/api/v1/bundles"
JITO_MIN_TIP_LAMPORTS="1000000"
# If Jito sendBundle errors (network/RPC), retry once via normal RPC send:
EXECUTION_JITO_FALLBACK_RPC="false"

# Compute budget on merged arb tx (recommended for DLMM CU-heavy swaps):
COMPUTE_UNIT_LIMIT="1400000"
PRIORITY_FEE_MICRO_LAMPORTS="0"

# Run simulateTransaction before LIVE send/bundle (strongly recommended):
EXECUTION_SKIP_SIMULATE="false"
# Required for EXECUTION_MODE=live — exact string only:
# EXECUTION_LIVE_CONFIRM="I_UNDERSTAND_REAL_SOLANA_FUNDS_AND_SLIPPAGE"
EXECUTION_LIVE_CONFIRM=""
# solana-keygen export JSON array of 64 secret bytes — NEVER commit; NEVER put on Vercel; worker/local only:
EXECUTOR_SECRET_KEY=""
