# Copy to apps/web/.env.vercel.secrets (gitignored), fill values, then from repo root:
#   VERCEL_TOKEN=xxx npm run vercel:push-env
# Optional: VERCEL_TEAM_ID=team_xxx   VERCEL_PROJECT_ID=prj_xxx

DATABASE_URL=postgresql://USER:PASS@HOST/db?sslmode=require
HELIUS_API_KEY=
ENGINE_INGEST_SECRET=
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=PASTE_HELIUS_KEY

# Required for chaos discovery button — single-line JSON (same shape as worker pool pairs):
DISCOVERY_POOL_PAIRS_JSON=[{"poolA":"YOUR_METEORA_LB_POOL_A","poolB":"YOUR_METEORA_LB_POOL_B","startMint":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","label":"DISCOVERY/USDC","amountRaw":"25000"}]
